{
  "name": "nexo-ahks",
  "version": "8.1.0",
  "description": "Nexo Ahks \u2014 block-based AutoHotkey v2 script builder",
  "main": "main.js",
  "author": "Nexoria",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "test": "node scripts/selftest.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1"
  },
  "build": {
    "appId": "org.nexoria.nexoahks",
    "productName": "Nexo Ahks",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png",
      "node_modules/monaco-editor/min/**",
      "!**/node_modules/monaco-editor/{dev,esm,min-maps}/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Nexo-Ahks-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexo Ahks",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "fileAssociations": [
      {
        "ext": "ahkb",
        "name": "Nexo Ahks project",
        "icon": "build/icon.ico"
      }
    ],
    "directories": {
      "buildResources": "build"
    }
  },
  "dependencies": {
    "monaco-editor": "^0.52.0"
  }
}
